# Copy to .env and fill in real values. Never commit .env.

# ---- Server ----
NODE_ENV=development
PORT=5000

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uptime_monitor
DB_USER=postgres
DB_PASSWORD=change_me

# JWT secrets — must be >=32 chars and DIFFERENT from each other in production.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_random_hex_at_least_32_chars_long
JWT_REFRESH_SECRET=replace_with_a_DIFFERENT_random_hex_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Origin allowed by CORS + Socket.IO. No trailing slash. Use the deployed client URL in prod.
CLIENT_URL=http://localhost:5173

# SSRF guard: when true, monitors may target private/loopback IPs (localhost demos).
# Leave false / unset in any shared or public deployment.
ALLOW_PRIVATE_URLS=false

# ---- Client (Vite) ----
# Base URL of the API. In dev with the Vite proxy or the Nginx compose setup, "/api" is fine.
# In split deploys (Vercel/Netlify client + Render server), set to the full API origin.
VITE_API_URL=/api
# Origin for Socket.IO. Use the same host as the API server.
VITE_SOCKET_URL=http://localhost:5000
