# server-java reads the same variables as the Node server. By default it also loads
# ../server/.env, so if that file exists you don't need this one. Values here (copied to
# server-java/.env) override it; real environment variables override both.

# --- required (startup fails without them) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uptime_monitor
DB_USER=postgres
DB_PASSWORD=
# >= 32 bytes each (HS256), and different from each other. Generate: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# 64 hex chars (32 bytes). Must be the SAME key the Node server used, or existing MFA
# enrollments can't be decrypted. Generate: openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# --- optional ---
# HTTP API port (the Vite dev proxy targets 5000)
PORT=5000
# Socket.IO port (client: `npm run dev:java` points VITE_SOCKET_URL here)
SOCKET_PORT=5001
# "production" enables strict secret checks and hides 5xx error details
NODE_ENV=development
# true = let monitors/alert webhooks target localhost/private IPs (local testing only)
ALLOW_PRIVATE_URLS=false
